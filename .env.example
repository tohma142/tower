# Copy to .env for local overrides. All values are optional; defaults are shown.
# Never commit a real .env — it is gitignored.

# Port the HTTP + WebSocket server listens on.
PORT=3000

# Interface to bind. Use 0.0.0.0 to let other machines on your LAN join a game.
HOST=127.0.0.1

# One of: debug | info | warn | error
LOG_LEVEL=info
